{
	"name": "marbleblast",
	"version": "1.0.0",
	"description": "A full web port of Marble Blast Gold.",
	"scripts": {
		"test": "echo \"Error: no test specified\" && exit 1",
		"watch": "rollup -c -w",
		"watch-fast": "rollup -c rollup-fast.config.mjs -w",
		"compile": "rollup -c",
		"bundle": "vite build",
		"build": "npm run lint && npm run compile && npm run bundle",
		"start": "node server/bundle.js",
		"lint": "eslint src/ts server/ts",
		"check": "tsc --noEmit"
	},
	"author": "Vanilagy",
	"license": "ISC",
	"engines": {
		"node": ">=24"
	},
	"dependencies": {
		"@rollup/plugin-commonjs": "^29.0.3",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@types/finalhandler": "^1.2.4",
		"@types/node": "^24.19.2",
		"@types/serve-static": "^2.2.0",
		"@types/wicg-file-system-access": "^2023.10.7",
		"@types/write-file-atomic": "^4.0.3",
		"finalhandler": "^2.1.1",
		"jszip": "^3.10.2",
		"rollup": "^4.65.0",
		"rollup-plugin-external-globals": "^0.13.0",
		"rollup-plugin-node-externals": "^9.0.1",
		"rollup-plugin-typescript2": "^0.37.0",
		"serve-static": "^2.2.1",
		"typescript": "~6.0.3",
		"vite": "^8.3.5",
		"write-file-atomic": "^8.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"eslint": "^10.13.0",
		"globals": "^17.13.0",
		"typescript-eslint": "^8.72.0"
	}
}
